# Bot token. Keep the real value private.
TOKEN=your_discord_bot_token

# Discord application/client ID.
CLIENT_ID=your_discord_application_id

# Optional server ID for your bot.
GUILD_ID=your_discord_server_id

# OAuth secret. Never put this in frontend code.
CLIENT_SECRET=your_discord_client_secret

# Public ngrok URL for this backend.
PUBLIC_URL=https://bovine-amiable-chalice.ngrok-free.dev

# Exact callback registered in the Discord Developer Portal.
DISCORD_REDIRECT_URI=https://ow-core.github.io

# Long random value used to sign login sessions.
SESSION_SECRET=replace_with_a_long_random_secret

# Homepage to return to after login.
FRONTEND_URL=https://ow-core.github.io

PORT=7112
